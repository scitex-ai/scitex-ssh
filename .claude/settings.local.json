  "model": "haiku",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "./docs/to_claude/hooks/pre-tool-use/limit_line_numbers.sh"
          },
          {
            "type": "command",
            "command": "./docs/to_claude/hooks/pre-tool-use/inhibit_project_root_pollution.sh"
          },
          {
            "type": "command",
            "command": "./docs/to_claude/hooks/pre-tool-use/deny_inline_script_in_html.sh"
          },
          {
            "type": "command",
            "command": "./docs/to_claude/hooks/pre-tool-use/deny_inline_style_in_html.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./docs/to_claude/hooks/pre-tool-use/enforce_force_flag.sh"
          },
          {
            "type": "command",
            "command": "./docs/to_claude/hooks/pre-tool-use/enforce_git_dash_C.sh"
          },
          {
            "type": "command",
            "command": "./docs/to_claude/hooks/pre-tool-use/enforce_pytest_fullpath.sh"
          },
          {
            "type": "command",
            "command": "./docs/to_claude/hooks/pre-tool-use/pipe-stage-permissions.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "./docs/to_claude/hooks/post-tool-use/ensure_executable.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "./docs/to_claude/hooks/post-tool-use/format_code.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "./docs/to_claude/hooks/post-tool-use/run_lint.sh",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "./docs/to_claude/hooks/post-tool-use/log_post_tool_use.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./docs/to_claude/hooks/notification/notify_voice.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-code-plugins": true
  },
  "promptSuggestionEnabled": false,
  "effortLevel": "high"
}
