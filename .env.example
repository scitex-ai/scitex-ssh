# scitex-ssh environment variables
#
# Copy this file to `.env` (gitignored) and edit values for your setup.
# CLI flags always override env vars when both are given. Variables
# follow the SciTeX ecosystem convention: SCITEX_<MODULE>_<NAME>.
#
# Local state (per the SciTeX local-state convention) is read from:
#   ~/.scitex/ssh/                user-global config + cache
#   <proj-root>/.scitex/ssh/      project-local overrides (preferred)

# Default bastion (jump) server. Skip the `-b` flag when set.
# SCITEX_SSH_BASTION_SERVER=user@bastion.example.com

# Default private key path. Skip the `-s` flag when set.
# SCITEX_SSH_SECRET_KEY_PATH=~/.ssh/id_rsa

# Verbose CLI output. 1 = on, 0 = off (default).
# SCITEX_SSH_DEBUG_MODE=0
