# scitex-ssh environment variables
# Copy to .env and fill in your values

# Default bastion server (user@hostname)
# SCITEX_SSH_BASTION_SERVER=user@bastion.example.com

# Default SSH private key path
# SCITEX_SSH_SECRET_KEY_PATH=~/.ssh/id_rsa

# Debug mode (set to 1 for verbose output)
# SCITEX_SSH_DEBUG_MODE=0
